# Deny-all: ignore everything at the repository root by default.
# Only the entries explicitly un-ignored below will be tracked.
/*

# --- Git & editor housekeeping ---
!/.gitignore
!/.htaccess

# --- Custom theme / plugin code ---
!/custom/
!/custom/**

# --- Conferences ---
!/confs/
!/confs/**

# --- Standalone video galleries (/vids/; WordPress keeps /videos/) ---
!/vids/
!/vids/**

# --- Conference build / deploy scripts ---
!/scripts/
!/scripts/**

# Re-ignore install output under scripts/ (the un-ignore above would otherwise track it)
/scripts/node_modules/

# Local promo clips (must come after !/confs/** — .gitignore beats info/exclude)
/confs/2026/videos/clips/
/confs/2026/videos/.venv-clips

# --- .github ---
!/.github/
!/.github/**

# --- Media files ---
*.mp4
*.mp3
*.wav
*.ogg
*.flac
*.m4a
*.m4v
*.mov
*.avi
*.wmv
*.mkv
*.webm
*.webp
*.jpg
*.jpeg
*.png
*.gif
*.svg
*.ico
*.webp
*.jpg
*.jpeg
*.png
*.gif
*.svg
*.pdf

# --- Utility scripts & misc data ---
# !/fetch-wordpress.sh
# !/various/
# !/various/**

# --- Database dump (password-protected ZIP) ---
# Add the dump file to the repo root and it will be tracked.
!/*.zip

# --- Documentation ---
!/README.md
confs/2026/videos/KERICONF26/
confs/2026/videos/KERICONF26-interviews/

.DS_Store

# YouTube uploader (local only; see README.md)
.youtube-credentials.json
.youtube-client-secret.json
.youtube-upload-state.json
.transcripts-build.html
.chrome-profile/
