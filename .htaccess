# Block the include-only files.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^wp-admin/includes/ - [F,L]
RewriteRule !^wp-includes/ - [S=3]
RewriteRule ^wp-includes/[^/]+\.php$ - [F,L]
RewriteRule ^wp-includes/js/tinymce/langs/.+\.php - [F,L]
RewriteRule ^wp-includes/theme-compat/ - [F,L]
</IfModule>
<Files wp-config.php>
<IfModule !mod_authz_core.c>
order allow,deny
deny from all
</IfModule>
<IfModule mod_authz_core.c>
require all denied
</IfModule>
</Files>

# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /


# BEGIN conf redirects
# KERI Conference April 2026
RewriteRule ^confs/2026/videos/?$ /confs/KERI/2026/apr/ [R=301,L]
RewriteRule ^confs/2026/videos/index\.html$ /confs/KERI/2026/apr/ [R=301,L]
RewriteRule ^confs/2026/videos/index\.json$ /confs/KERI/2026/apr/index.json [R=301,L]

RewriteRule ^confs/2026/videos/KERICONF26/subtitles/([^/]+)$ /confs/KERI/2026/apr/talks/$1 [R=301,L,NE]
RewriteRule ^confs/2026/videos/KERICONF26/presentations/([^/]+)$ /confs/KERI/2026/apr/slides/$1 [R=301,L,NE]
RewriteRule ^confs/2026/videos/KERICONF26/transcripts/(.*)$ /confs/KERI/2026/apr/transcripts/html/talks/$1 [R=301,L,NE]
RewriteRule ^confs/2026/videos/KERICONF26/([^/]+\.(mp4|mp3))$ /confs/KERI/2026/apr/talks/$1 [R=301,L,NE]

RewriteRule ^confs/2026/videos/KERICONF26-interviews/subtitles/([^/]+\.srt)$ /confs/KERI/2026/apr/interviews/$1 [R=301,L,NE]
RewriteRule ^confs/2026/videos/KERICONF26-interviews/transcripts/(.*)$ /confs/KERI/2026/apr/transcripts/html/interviews/$1 [R=301,L,NE]
RewriteRule ^confs/2026/videos/KERICONF26-interviews/([^/]+\.(mp4|mp3))$ /confs/KERI/2026/apr/interviews/$1 [R=301,L,NE]

RewriteRule ^confs/2026/videos/KERICONF26-promo/Keri2026Promo\.(mp4|jpg)$ /confs/KERI/2026/apr/promo/promo.$1 [R=301,L]

# SEDI Summit November 2025
RewriteRule ^confs/2026/videos/SEDI/2025-11-SEDI/?$ /confs/SEDI/2025/nov/ [R=301,L]
RewriteRule ^confs/2026/videos/SEDI/2025-11-SEDI/index\.html$ /confs/SEDI/2025/nov/ [R=301,L]
RewriteRule ^confs/2026/videos/SEDI/2025-11-SEDI/index\.json$ /confs/SEDI/2025/nov/index.json [R=301,L]

RewriteRule ^confs/2026/videos/SEDI/2025-11-SEDI/State-Endorsed-Digital-Identity-Summit-Morning-Session/speakers/([^/]+)$ /confs/SEDI/2025/nov/talks/morning-$1 [R=301,L,NE]
RewriteRule ^confs/2026/videos/SEDI/2025-11-SEDI/State-Endorsed-Digital-Identity-Summit-Lunch-Panel/speakers/([^/]+)$ /confs/SEDI/2025/nov/talks/lunch-$1 [R=301,L,NE]
RewriteRule ^confs/2026/videos/SEDI/2025-11-SEDI/State-Endorsed-Digital-Identity-Summit-Afternoon-Session/speakers/([^/]+)$ /confs/SEDI/2025/nov/talks/afternoon-$1 [R=301,L,NE]

RewriteRule ^confs/2026/videos/SEDI/2025-11-SEDI/speaker-photos/([^/]+)$ /confs/SEDI/2025/nov/speaker-photos/$1 [R=301,L,NE]
RewriteRule ^confs/2026/videos/SEDI/2025-11-SEDI/poster-sedi-summit\.jpg$ /confs/SEDI/2025/nov/promo/poster-sedi-summit.jpg [R=301,L]
RewriteRule ^confs/2026/videos/SEDI/2025-11-SEDI/transcripts/(.*)$ /confs/SEDI/2025/nov/transcripts/html/talks/$1 [R=301,L,NE]
RewriteRule ^confs/2026/videos/SEDI/2025-11-SEDI/pdf/([^/]+)$ /confs/SEDI/2025/nov/transcripts/pdf/talks/$1 [R=301,L,NE]
# END conf redirects

# BEGIN vids redirects
# Standalone player moved into the 2026 gallery. /videos/ stays with WordPress.
RewriteRule ^videos/sam-smith/Its-KERI-or-Surveillance/Its-KERI-or-Surveillance\.html$ /vids/2026/#it-s-keri-or-surveillance-samuel-smith [R=301,L,NE]
# Former monthly path now lives at the year gallery.
RewriteRule ^vids/2026/jul(?:/(.*))?$ /vids/2026/$1 [R=301,L,NE]
# END vids redirects





RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress