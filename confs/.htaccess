# Hostinger/LiteSpeed ignores AutoIndexUri and HTML-escapes HEADER.html.
# /confs/ is the generated overview (index.html). Bare subdirs without their
# own index are rewritten to index.php.
#
# Legacy redirects live here, not in the site-root .htaccess. Once this
# directory enables its own rewrite engine, LiteSpeed does not apply parent
# rewrite rules to /confs/ URLs.
Options -Indexes
DirectoryIndex index.html index.php

# Prefer HTML transcript pages in Google. Concatenated PDFs stay downloadable
# but are not indexed (do not Disallow them in robots.txt — that freezes
# already-indexed copies). Slide PDFs under slides/ are left alone.
<IfModule mod_setenvif.c>
SetEnvIf Request_URI "transcripts/pdf/.*\.pdf$" noindex_transcript_pdf
</IfModule>
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, follow" env=noindex_transcript_pdf
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /confs/

# BEGIN conf redirects
# KERI Conference April 2026
RewriteRule ^2026/videos/?$ /confs/KERI/2026/apr/ [R=301,L]
RewriteRule ^2026/videos/index\.html$ /confs/KERI/2026/apr/ [R=301,L]
RewriteRule ^2026/videos/index\.json$ /confs/KERI/2026/apr/index.json [R=301,L]

RewriteRule ^2026/videos/KERICONF26/subtitles/([^/]+)$ /confs/KERI/2026/apr/talks/$1 [R=301,L,NE]
RewriteRule ^2026/videos/KERICONF26/presentations/([^/]+)$ /confs/KERI/2026/apr/slides/$1 [R=301,L,NE]
RewriteRule ^2026/videos/KERICONF26/transcripts/(.*)$ /confs/KERI/2026/apr/transcripts/html/talks/$1 [R=301,L,NE]
RewriteRule ^2026/videos/KERICONF26/([^/]+\.(mp4|mp3))$ /confs/KERI/2026/apr/talks/$1 [R=301,L,NE]

RewriteRule ^2026/videos/KERICONF26-interviews/subtitles/([^/]+\.srt)$ /confs/KERI/2026/apr/interviews/$1 [R=301,L,NE]
RewriteRule ^2026/videos/KERICONF26-interviews/transcripts/(.*)$ /confs/KERI/2026/apr/transcripts/html/interviews/$1 [R=301,L,NE]
RewriteRule ^2026/videos/KERICONF26-interviews/([^/]+\.(mp4|mp3))$ /confs/KERI/2026/apr/interviews/$1 [R=301,L,NE]

RewriteRule ^2026/videos/KERICONF26-promo/Keri2026Promo\.(mp4|jpg)$ /confs/KERI/2026/apr/promo/promo.$1 [R=301,L]

# SEDI Summit November 2025
RewriteRule ^2026/videos/SEDI/2025-11-SEDI/?$ /confs/SEDI/2025/nov/ [R=301,L]
RewriteRule ^2026/videos/SEDI/2025-11-SEDI/index\.html$ /confs/SEDI/2025/nov/ [R=301,L]
RewriteRule ^2026/videos/SEDI/2025-11-SEDI/index\.json$ /confs/SEDI/2025/nov/index.json [R=301,L]

RewriteRule ^2026/videos/SEDI/2025-11-SEDI/State-Endorsed-Digital-Identity-Summit-Morning-Session/speakers/([^/]+)$ /confs/SEDI/2025/nov/talks/morning-$1 [R=301,L,NE]
RewriteRule ^2026/videos/SEDI/2025-11-SEDI/State-Endorsed-Digital-Identity-Summit-Lunch-Panel/speakers/([^/]+)$ /confs/SEDI/2025/nov/talks/lunch-$1 [R=301,L,NE]
RewriteRule ^2026/videos/SEDI/2025-11-SEDI/State-Endorsed-Digital-Identity-Summit-Afternoon-Session/speakers/([^/]+)$ /confs/SEDI/2025/nov/talks/afternoon-$1 [R=301,L,NE]

RewriteRule ^2026/videos/SEDI/2025-11-SEDI/speaker-photos/([^/]+)$ /confs/SEDI/2025/nov/speaker-photos/$1 [R=301,L,NE]
RewriteRule ^2026/videos/SEDI/2025-11-SEDI/poster-sedi-summit\.jpg$ /confs/SEDI/2025/nov/promo/poster-sedi-summit.jpg [R=301,L]
RewriteRule ^2026/videos/SEDI/2025-11-SEDI/transcripts/(.*)$ /confs/SEDI/2025/nov/transcripts/html/talks/$1 [R=301,L,NE]
RewriteRule ^2026/videos/SEDI/2025-11-SEDI/pdf/([^/]+)$ /confs/SEDI/2025/nov/transcripts/pdf/talks/$1 [R=301,L,NE]
# END conf redirects

# Directories that already have index.html / index.php keep those.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{REQUEST_FILENAME}/index.php !-f
RewriteRule ^(.*)$ index.php?path=$1 [L,QSA]
</IfModule>
