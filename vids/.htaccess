# Hostinger/LiteSpeed ignores AutoIndexUri and HTML-escapes HEADER.html.
# /vids/ is the generated overview (index.html). Bare subdirs without their
# own index are rewritten to index.php.
#
# Legacy year-level redirects live here. LiteSpeed does not apply parent
# rewrite rules once this directory enables its own rewrite engine.
Options -Indexes
DirectoryIndex index.html index.php

# Prefer HTML transcript pages in Google. Concatenated PDFs stay downloadable
# but are not indexed (do not Disallow them in robots.txt — that freezes
# already-indexed copies). Slide PDFs under slides/ are left alone.
<IfModule mod_setenvif.c>
SetEnvIf Request_URI "transcripts/pdf/.*\.pdf$" noindex_transcript_pdf
</IfModule>
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, follow" env=noindex_transcript_pdf
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /vids/

# BEGIN vids redirects
# Former year-level galleries now live under /vids/<YEAR>/<month>/.

# Introduction to KERI Part 1 - Samuel Smith → /vids/2026/may/
RewriteRule ^2026/talks/(2026-05-05-Introduction-to-KERI-Part-1-XYohZTh3yEw(?:\.[a-z]{2,3})?\.(?:mp4|mp3|srt))$ /vids/2026/may/talks/$1 [R=301,L,NE]
RewriteRule ^2026/transcripts/html/talks/introduction-to-keri-part-1-samuel-smith\.html$ /vids/2026/may/transcripts/html/talks/introduction-to-keri-part-1-samuel-smith.html [R=301,L]

# It's KERI or Surveillance - Samuel Smith → /vids/2026/jul/
RewriteRule ^2026/talks/(Its-KERI-or-Surveillance(?:\.[a-z]{2,3})?\.(?:mp4|mp3|srt|pdf))$ /vids/2026/jul/talks/$1 [R=301,L,NE]
RewriteRule ^2026/transcripts/html/talks/it-s-keri-or-surveillance-samuel-smith\.html$ /vids/2026/jul/transcripts/html/talks/it-s-keri-or-surveillance-samuel-smith.html [R=301,L]

# 2020 / 2024 year-level paths
RewriteRule ^2020/talks/(NonconformistKeynoteWeb20200702(?:\.[a-z]{2,3})?\.(?:mp4|mp3|srt))$ /vids/2020/jul/talks/$1 [R=301,L,NE]
RewriteRule ^2020/slides/(NonconformistKeynoteWeb20200702\.pdf)$ /vids/2020/jul/slides/$1 [R=301,L,NE]
RewriteRule ^2020/transcripts/html/talks/nonconformist-keynote-samuel-smith\.html$ /vids/2020/jul/transcripts/html/talks/nonconformist-keynote-samuel-smith.html [R=301,L]

RewriteRule ^2024/talks/(2024-01-02-Introduction-to-KERI-Samuel-M-Smith-yP3eIl4VgA(?:\.[a-z]{2,3})?\.(?:mp4|mp3|srt))$ /vids/2024/jan/talks/$1 [R=301,L,NE]
RewriteRule ^2024/transcripts/html/talks/introduction-to-keri-samuel-smith\.html$ /vids/2024/jan/transcripts/html/talks/introduction-to-keri-samuel-smith.html [R=301,L]
# END vids redirects

# Directories that already have index.html / index.php keep those.
# Year folders (2020/, 2024/, 2026/) ship a small redirect index.html for old
# year-gallery bookmarks and hash deep links.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html !-f
RewriteCond %{REQUEST_FILENAME}/index.php !-f
RewriteRule ^(.*)$ index.php?path=$1 [L,QSA]
</IfModule>
